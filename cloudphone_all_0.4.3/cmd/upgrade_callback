#!/bin/bash

### 升级回调：端口与数据保持不变，只重建容器并重启网关

set -u
APP_DIR="${TRIM_APPDEST:-/var/apps/cloudphone/target}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/cloudphone/var}"
LOG="$VAR_DIR/upgrade.log"
COMPOSE="$APP_DIR/docker/docker-compose.yaml"
PORTS_CONF="$VAR_DIR/ports.conf"

mkdir -p "$VAR_DIR" 2>/dev/null || true
if : >>"$LOG" 2>/dev/null; then exec >>"$LOG" 2>&1; fi

say(){ echo "[$(date '+%F %T')] $*"; }
say "==== upgrade_callback 开始 ===="

### 1) 端口：升级默认一概不动。仅当向导显式提供了某项端口值时才改那一项。
PW="${wizard_web_port:-}"; PT="${wizard_turn_port:-}"; PR="${wizard_relay_range:-}"
if [ -n "$PW" ] || [ -n "$PT" ] || [ -n "$PR" ]; then
    PORTS_CONF="$VAR_DIR/ports.conf"
    WEB=$(sed -n 's/^WEB_PORT=//p'   "$PORTS_CONF" 2>/dev/null | head -n1); [ -n "$WEB" ]  || WEB=8443
    TURN=$(sed -n 's/^TURN_PORT=//p' "$PORTS_CONF" 2>/dev/null | head -n1); [ -n "$TURN" ] || TURN=3478
    RMIN=$(sed -n 's/^RELAY_MIN=//p' "$PORTS_CONF" 2>/dev/null | head -n1); [ -n "$RMIN" ] || RMIN=50000
    RMAX=$(sed -n 's/^RELAY_MAX=//p' "$PORTS_CONF" 2>/dev/null | head -n1); [ -n "$RMAX" ] || RMAX=50100
    [ -n "$PW" ] && WEB="$PW"
    [ -n "$PT" ] && TURN="$PT"
    if [ -n "$PR" ]; then
        case "$PR" in *-*) RMIN="${PR%%-*}"; RMAX="${PR##*-}" ;; esac
    fi
    case "$WEB"  in ''|*[!0-9]*) WEB=8443 ;; esac
    case "$TURN" in ''|*[!0-9]*) TURN=3478 ;; esac
    case "$RMIN" in ''|*[!0-9]*) RMIN=50000 ;; esac
    case "$RMAX" in ''|*[!0-9]*) RMAX=50100 ;; esac
    [ "$RMIN" -le "$RMAX" ] || { _t="$RMIN"; RMIN="$RMAX"; RMAX="$_t"; }
    {
        echo "WEB_PORT=$WEB"; echo "TURN_PORT=$TURN"
        echo "RELAY_MIN=$RMIN"; echo "RELAY_MAX=$RMAX"
        echo "UPDATED=$(date '+%F %T')"
    } > "$PORTS_CONF" 2>/dev/null || true
    say "端口按升级向导更新：画面=$WEB TURN=$TURN 中继=${RMIN}-${RMAX}"
else
    say "端口保持不变（升级不改端口）"
fi

### 1.5) 镜像版本策略落盘（钉死 digest / 跟随 latest，写 compose 的 image: 行）
if [ -f "$APP_DIR/scripts/set_image.sh" ]; then
    bash "$APP_DIR/scripts/set_image.sh" --apply 2>&1 | sed 's/^/  /'
fi

### 2) 端口写回 compose
if [ -f "$APP_DIR/scripts/apply_ports.sh" ]; then
    bash "$APP_DIR/scripts/apply_ports.sh" --no-restart >/dev/null 2>&1 \
        && say "端口已写入 compose" || say "端口写入 compose 失败"
fi

### 3) 网络模式按已保存配置重放（幂等，不重启）
if [ -f "$APP_DIR/scripts/net_mode.sh" ]; then
    bash "$APP_DIR/scripts/net_mode.sh" --no-restart 2>&1 | sed 's/^/  /'
fi

### 4) compose 落盘
if [ -f "$COMPOSE" ]; then
    mkdir -p /docker 2>/dev/null || true
    cp -f "$COMPOSE" /docker/docker-compose.yaml 2>/dev/null || true
    chmod 644 /docker/docker-compose.yaml 2>/dev/null || true
fi

### 4.5) 数据卷兜底（external 卷缺失会导致 compose up 失败；幂等）
VOL="cloudphone-webrtc-data"
docker volume inspect "$VOL" >/dev/null 2>&1 || docker volume create "$VOL" >/dev/null 2>&1 || true

### 5) 重建容器（用新镜像；数据卷 cloudphone-webrtc-data 保留）
if [ -f "$COMPOSE" ]; then
    ( cd "$APP_DIR/docker" && docker compose -p cloudphone up -d --force-recreate webrtc ) 2>&1 | sed 's/^/  /'
    say "容器已按新镜像重建"
fi

### 6) 重启网关（版本号变化会触发一次强制换页，清掉旧缓存）
if [ -f "$APP_DIR/server/gateway.py" ]; then
    python3 "$APP_DIR/server/gateway.py" restart 2>&1 | sed 's/^/  /'
    say "网关已重启"
fi

### 7) 看护
if [ -f "$APP_DIR/scripts/webrtc_watchdog.sh" ]; then
    bash "$APP_DIR/scripts/webrtc_watchdog.sh" install 2>&1 | sed 's/^/  /'
fi

say "==== upgrade_callback 完成 ===="
exit 0
