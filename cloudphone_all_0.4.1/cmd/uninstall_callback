#!/bin/bash

### 卸载回调：清理容器/网络；镜像与数据卷按向导选择处理
###
### 向导字段：
###   wizard_delete_images = true|false   （默认 false：保留镜像，便于重装快速恢复）
###   wizard_keep_data     = true|false   （默认 true ：保留数据卷，账号与设备绑定不丢）

set -u
APP_DIR="${TRIM_APPDEST:-/var/apps/cloudphone/target}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/cloudphone/var}"
COMPOSE="$APP_DIR/docker/docker-compose.yaml"
LOG="$VAR_DIR/uninstall.log"

mkdir -p "$VAR_DIR" 2>/dev/null || true
if : >>"$LOG" 2>/dev/null; then exec >>"$LOG" 2>&1; fi
say(){ echo "[$(date '+%F %T')] $*"; }
say "==== uninstall_callback 开始 ===="

### 1) 停止看护与网关（幂等，防止残留进程；进程兜底杀，避免旧版看护循环复活容器）
if [ -f "$APP_DIR/scripts/webrtc_watchdog.sh" ]; then
    bash "$APP_DIR/scripts/webrtc_watchdog.sh" remove >/dev/null 2>&1 || true
fi
if [ -f "$APP_DIR/server/gateway.py" ]; then
    python3 "$APP_DIR/server/gateway.py" stop >/dev/null 2>&1 || true
fi
pkill -9 -f 'cloudphone.*webrtc_watchdog\.sh' >/dev/null 2>&1 || true
pkill -9 -f '/var/apps/cloudphone/.*webrtc_watchdog\.sh' >/dev/null 2>&1 || true
pkill -9 -f 'cloudphone/target/server/gateway\.py' >/dev/null 2>&1 || true

### 2) 移除容器与网络（-v 不传，数据卷不动）
if [ -f "$COMPOSE" ]; then
    ( cd "$APP_DIR/docker" && timeout 180 docker compose -p cloudphone down --remove-orphans ) >/dev/null 2>&1 || true
fi
### 兜底 1：按容器名强删（compose 文件缺失/项目标签不一致时 down 可能删不掉）
docker rm -f cloudphone-webrtc >/dev/null 2>&1 || true
### 兜底 2：按 compose 项目标签清理本项目所有容器（含异常残留）
_pids=$(docker ps -aq --filter "label=com.docker.compose.project=cloudphone" 2>/dev/null)
[ -n "$_pids" ] && docker rm -f $_pids >/dev/null 2>&1 || true
### 兜底 3：网络
docker network rm cloudphone_default >/dev/null 2>&1 || true
if docker ps -a --format '{{.Names}}' | grep -q '^cloudphone-webrtc$'; then
    say "警告：容器 cloudphone-webrtc 仍存在，请手动执行 docker rm -f cloudphone-webrtc"
else
    say "容器与网络已移除"
fi

### 3) 镜像：仅当向导明确选择「同时删除镜像」时才删
if [ "${wizard_delete_images:-false}" = "true" ]; then
    if [ -f "$APP_DIR/scripts/rtconf.sh" ]; then
        # shellcheck disable=SC1091
        . "$APP_DIR/scripts/rtconf.sh"
        rtconf_load
    fi
    : "${CANON_WEBRTC:=docker.fnnas.com/buutuu/scrcpy-over-webrtc:latest}"
    : "${OFF_WEBRTC:=buutuu/scrcpy-over-webrtc:latest}"
    : "${CACHE_WEBRTC:=cloudphone-cache/webrtc:latest}"
    : "${PINNED_WEBRTC:=cloudphone-cache/webrtc:pinned}"
    docker rmi -f "$CANON_WEBRTC" "$OFF_WEBRTC" "$CACHE_WEBRTC" "$PINNED_WEBRTC" >/dev/null 2>&1 || true
    # 兜底：按引用名清扫所有别名/悬空镜像（钉 digest 后镜像可能只有 @sha256 引用），
    # 以及 compose 实际引用的本地稳定 tag（cloudphone-cache/webrtc:pinned）。
    # 先按镜像 ID 去重再删，避免同 ID 多 tag 时残留 <none> 悬空镜像。
    _ids=$(
        { docker images -q --filter "reference=*scrcpy-over-webrtc*" 2>/dev/null
          docker images -q --filter "reference=cloudphone-cache/*" 2>/dev/null; } | sort -u
    )
    [ -n "$_ids" ] && docker rmi -f $_ids >/dev/null 2>&1 || true
    if docker images --format '{{.Repository}}' 2>/dev/null | grep -qE 'scrcpy-over-webrtc|cloudphone-cache'; then
        say "警告：仍有穿云投屏镜像残留，请手动执行 docker images | grep -E 'scrcpy|cloudphone-cache' 后删除"
    else
        say "镜像已按向导删除"
    fi
else
    say "保留镜像（wizard_delete_images=${wizard_delete_images:-未提供}）"
fi

### 4) 数据卷：默认保留，只有向导明确选择「删除数据」时才删（连同卸载前的备份一起删）
if [ "${wizard_keep_data:-true}" = "false" ]; then
    docker volume rm cloudphone-webrtc-data >/dev/null 2>&1 || true
    rm -f "$VAR_DIR/webrtc-data-backup.tar.gz" 2>/dev/null || true
    say "数据卷与备份已删除（账号与设备绑定将丢失）"
else
    say "保留数据卷与备份（wizard_keep_data=${wizard_keep_data:-未提供}）；重装时若卷为空会自动恢复"
fi

say "==== uninstall_callback 完成 ===="
exit 0
