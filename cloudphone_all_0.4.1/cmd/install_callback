#!/bin/bash

### 安装回调（正式安装阶段执行）
### 顺序：端口 → 网络模式 → compose 落盘 → 启动容器 → 启动网关 → 启动看护

set -u
APP_DIR="${TRIM_APPDEST:-/var/apps/cloudphone/target}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/cloudphone/var}"
LOG="$VAR_DIR/install.log"
COMPOSE="$APP_DIR/docker/docker-compose.yaml"
PORTS_CONF="$VAR_DIR/ports.conf"

mkdir -p "$VAR_DIR" 2>/dev/null || true
: > "$LOG" 2>/dev/null || true
if : >>"$LOG" 2>/dev/null; then exec >>"$LOG" 2>&1; fi

say(){ echo "[$(date '+%F %T')] $*"; }

say "==== install_callback 开始，架构 $(uname -m) ===="
say "APP_DIR=$APP_DIR VAR_DIR=$VAR_DIR"
say "（免责/许可由应用中心「协议许可」弹窗强制勾选，此处不再重复校验）"

### 0) 目录与权限
mkdir -p "$APP_DIR/docker" 2>/dev/null || true
[ -f "$COMPOSE" ] || say "警告：compose 不存在：$COMPOSE"

### 1) 端口：想改哪个填哪个，不填的保持默认 —— 只改用户填写的那几项，其余不动。
PW="${wizard_web_port:-}"
PT="${wizard_turn_port:-}"
PR="${wizard_relay_range:-}"

port_cur(){ sed -n "s/^$1=//p" "$PORTS_CONF" 2>/dev/null | head -n1; }

WEB="$(port_cur WEB_PORT)";   [ -n "$WEB" ]  || WEB=8443
TURN="$(port_cur TURN_PORT)"; [ -n "$TURN" ] || TURN=3478
RMIN="$(port_cur RELAY_MIN)"; [ -n "$RMIN" ] || RMIN=50000
RMAX="$(port_cur RELAY_MAX)"; [ -n "$RMAX" ] || RMAX=50100

_changed=""
if [ -n "$PW" ]; then WEB="$PW"; _changed="$_changed 画面=$WEB"; fi
if [ -n "$PT" ]; then TURN="$PT"; _changed="$_changed TURN=$TURN"; fi
if [ -n "$PR" ]; then
    case "$PR" in
        *-*) RMIN="${PR%%-*}"; RMAX="${PR##*-}"; _changed="$_changed 中继=${RMIN}-${RMAX}" ;;
        *)   say "向导中继段格式非法（$PR），沿用默认 ${RMIN}-${RMAX}" ;;
    esac
fi
case "$WEB"  in ''|*[!0-9]*) WEB=8443 ;; esac
case "$TURN" in ''|*[!0-9]*) TURN=3478 ;; esac
case "$RMIN" in ''|*[!0-9]*) RMIN=50000 ;; esac
case "$RMAX" in ''|*[!0-9]*) RMAX=50100 ;; esac
[ "$RMIN" -le "$RMAX" ] || { _t="$RMIN"; RMIN="$RMAX"; RMAX="$_t"; }

{
    echo "WEB_PORT=$WEB"
    echo "TURN_PORT=$TURN"
    echo "RELAY_MIN=$RMIN"
    echo "RELAY_MAX=$RMAX"
    echo "UPDATED=$(date '+%F %T')"
} > "$PORTS_CONF" 2>/dev/null || say "警告：无法写入 $PORTS_CONF"
if [ -n "$_changed" ]; then
    say "端口按向导修改：$_changed（其余保持不变）"
else
    say "端口全部使用默认值：画面=$WEB TURN=$TURN 中继=${RMIN}-${RMAX}"
fi

### 1.5) 镜像版本策略落盘（钉死 digest / 跟随 latest，写在 compose 的 image: 行）
if [ -f "$APP_DIR/scripts/set_image.sh" ]; then
    bash "$APP_DIR/scripts/set_image.sh" --apply 2>&1 | sed 's/^/  /'
fi

### 2) 端口占用预检（只告警，不阻断安装：用户可装完再改端口）
if [ -f "$APP_DIR/scripts/apply_ports.sh" ]; then
    _chk=$(bash "$APP_DIR/scripts/apply_ports.sh" --check 2>&1)
    case "$_chk" in
        PORT_OK*) say "端口预检通过：$_chk" ;;
        *)        say "端口预检发现占用（不阻断安装）：$_chk" ;;
    esac
    bash "$APP_DIR/scripts/apply_ports.sh" --no-restart >/dev/null 2>&1 \
        && say "端口已写入 compose" || say "端口写入 compose 失败"
fi

### 3) 网络模式（自动判断；写入 PUBLIC_IP / USE_TLS，不在此重启容器）
if [ -f "$APP_DIR/scripts/detect_net.sh" ]; then
    bash "$APP_DIR/scripts/detect_net.sh" --apply 2>&1 | sed 's/^/  /'
elif [ -f "$APP_DIR/scripts/net_mode.sh" ]; then
    bash "$APP_DIR/scripts/net_mode.sh" lan --no-restart 2>&1 | sed 's/^/  /'
fi

### 4) compose 落盘到 /docker（飞牛 docker-project 读取该路径）
if [ -f "$COMPOSE" ]; then
    mkdir -p /docker 2>/dev/null || true
    cp -f "$COMPOSE" /docker/docker-compose.yaml 2>/dev/null || true
    chmod 644 /docker/docker-compose.yaml 2>/dev/null || true
    say "compose 已同步到 /docker/docker-compose.yaml"
fi

### 4.5) 数据卷：显式创建（external，不受 compose down -v 影响）；
###      若卷为空且存在卸载前的备份，则恢复 —— 保证「保留数据卸载」后重装数据仍在。
VOL="cloudphone-webrtc-data"
if ! docker volume inspect "$VOL" >/dev/null 2>&1; then
    docker volume create "$VOL" >/dev/null 2>&1 || true
    say "已创建数据卷 $VOL"
fi
BK="$VAR_DIR/webrtc-data-backup.tar.gz"
if [ -f "$BK" ]; then
    # 注意：必须 --entrypoint sh 覆盖上游 ENTRYPOINT（否则 sh -c 会被当成启动参数，
    # 容器会直接跑投屏服务而不是执行 tar，导致安装流程卡死）。
    _cnt=$(timeout 120 docker run --rm --entrypoint sh -v "$VOL":/data "$(
        sed -n 's|^image:[[:space:]]*||p' "$COMPOSE" | head -n1 | tr -d '\"'
    )" -c 'ls -A /data 2>/dev/null | wc -l' 2>/dev/null | tr -d '[:space:]')
    if [ "${_cnt:-0}" = "0" ]; then
        say "数据卷为空，正在恢复卸载前的备份（$(du -h "$BK" | cut -f1)）..."
        timeout 180 docker run --rm --entrypoint sh -v "$VOL":/data -v "$VAR_DIR":/backup "$(
            sed -n 's|^image:[[:space:]]*||p' "$COMPOSE" | head -n1 | tr -d '\"'
        )" -c 'cd /data && tar xzf /backup/webrtc-data-backup.tar.gz' >/dev/null 2>&1 \
            && say "数据已恢复" || say "警告：数据恢复失败，请手动检查 $BK"
    else
        say "数据卷已有数据（$_cnt 项），跳过恢复"
    fi
fi

### 5) 启动容器（先确保镜像就绪 + 清同名残留容器）
###    镜像必须在这里再确保一次：compose 引用的是本地稳定 tag（cloudphone-cache/webrtc:pinned），
###    只要该 tag 在，compose up 不会联网、不会被镜像源 401 卡住建不出容器。
if [ -f "$APP_DIR/scripts/pull_image.sh" ]; then
    bash "$APP_DIR/scripts/pull_image.sh" 2>&1 | sed 's/^/  /' || say "警告：镜像准备失败，容器可能无法启动"
fi
docker rm -f cloudphone-webrtc >/dev/null 2>&1 || true
if [ -f "$COMPOSE" ]; then
    _out=$( cd "$APP_DIR/docker" && timeout 300 docker compose -p cloudphone up -d webrtc 2>&1 )
    _rc=$?
    printf '%s\n' "$_out" | sed 's/^/  /'
    say "docker compose up 返回码：$_rc"
else
    say "错误：compose 缺失，跳过启动"
fi

### 6) 启动飞牛网关代理（幂等；健康时不会掐断在线会话）
if [ -f "$APP_DIR/server/gateway.py" ]; then
    python3 "$APP_DIR/server/gateway.py" start 2>&1 | sed 's/^/  /'
    if [ ! -S "$APP_DIR/app.sock" ]; then
        say "入口未就绪，用 gw_socket.sh 兜底启动"
        if [ -f "$APP_DIR/scripts/gw_socket.sh" ]; then
            bash "$APP_DIR/scripts/gw_socket.sh" start 2>&1 | sed 's/^/  /'
        fi
    fi
    if [ -S "$APP_DIR/app.sock" ]; then
        say "网关入口就绪：$APP_DIR/app.sock"
    else
        say "警告：网关入口仍未就绪（详见 $VAR_DIR/gateway.log）"
    fi
fi

### 7) 启动画面服务看护
if [ -f "$APP_DIR/scripts/webrtc_watchdog.sh" ]; then
    bash "$APP_DIR/scripts/webrtc_watchdog.sh" install 2>&1 | sed 's/^/  /'
fi

say "==== install_callback 完成 ===="
exit 0
